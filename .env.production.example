APP_ENV=production
LOG_LEVEL=INFO
DOCS_ENABLED=false

# Public TLS edge. DNS for this host must point at the deployment.
TRACTUSMIND_DOMAIN=tractusmind.example.com
ACME_EMAIL=ops@example.com

# Host validation and browser access. Keep CORS empty for server-to-server use.
TRUSTED_HOSTS=tractusmind.example.com,api,localhost,127.0.0.1
CORS_ORIGINS=
TRUST_FORWARDED_FOR=true

# API abuse/resource guards. Rate limiting is process-local per API replica.
REQUEST_MAX_BODY_BYTES=65536
MAX_CONCURRENT_REQUESTS=64
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Non-secret service endpoints. Credentials are loaded from Docker secret files.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tractusmind_knowledge
LLM_BASE_URL=https://provider.example/v1
LLM_MODEL=

# Enterprise OIDC access-token validation. Use exact issuer and API audience values from the IdP.
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://id.example.com/realms/tractusmind
OIDC_AUDIENCE=tractusmind-api
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_ROLE_CLAIMS=roles,realm_access.roles,groups
OIDC_ADMIN_ROLES=tractusmind-admin
OIDC_OPERATOR_ROLES=tractusmind-operator
OIDC_DISPLAY_NAME_CLAIMS=name,preferred_username,email
OIDC_HTTP_TIMEOUT_SECONDS=10
OIDC_CACHE_TTL_SECONDS=3600

# Optional Mission Control browser SSO. Register this as a PUBLIC Authorization Code + PKCE client.
# No client secret is required or accepted by the frontend flow.
TRACTUSMIND_OIDC_CLIENT_ID=tractusmind-mission-control
TRACTUSMIND_OIDC_SCOPES=openid profile email
TRACTUSMIND_OIDC_REDIRECT_URI=https://tractusmind.example.com/api/oidc/callback

GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_ATTEMPTS=4
# Signed GitHub push events can trigger immediate ingestion through /v1/webhooks/github.
# To enable them, create ./secrets/github_webhook_secret and include
# docker-compose.webhook.prod.yml when starting the production stack.
GITHUB_WEBHOOK_DELIVERY_TTL_SECONDS=86400

LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=0.5
PROVIDER_RETRY_MAX_SECONDS=8
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_BATCH_SIZE=32
HYBRID_PREFETCH_K=40
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32
RETRIEVAL_TOP_K=20
RERANK_TOP_K=6

DEBUG_EXACT_K=30
DEBUG_RRF_K=60
DEBUG_EXACT_WEIGHT=1.5
DEBUG_HYBRID_WEIGHT=1.0

GENERATION_CONTEXT_MAX_CHARS=24000
VERIFICATION_MAX_CLAIMS=12
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARS=6000

# Webhooks are immediate where available; polling remains the self-healing fallback for
# third-party repositories where TractusMind cannot install a webhook.
SOURCE_SYNC_INTERVAL_SECONDS=300
SOURCE_SYNC_LOCK_SECONDS=43200

METRICS_ENABLED=true
WORKER_METRICS_PORT=9101
SCHEDULER_METRICS_PORT=9102
dramatiq_prom_host=0.0.0.0
dramatiq_prom_port=9191

OTEL_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=tractusmind-api
OTEL_SAMPLE_RATIO=0.1

GRAFANA_ADMIN_USER=admin

# Resource defaults can be overridden per host after measurement.
API_MEMORY_LIMIT=4g
API_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=6g
WORKER_CPU_LIMIT=3.0
QDRANT_MEMORY_LIMIT=4g
QDRANT_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
REDIS_MEMORY_LIMIT=1g
REDIS_CPU_LIMIT=1.0
PROMETHEUS_MEMORY_LIMIT=2g
PROMETHEUS_CPU_LIMIT=1.5
GRAFANA_MEMORY_LIMIT=1g
GRAFANA_CPU_LIMIT=1.0
ALERTMANAGER_MEMORY_LIMIT=512m
ALERTMANAGER_CPU_LIMIT=0.5
CADDY_MEMORY_LIMIT=512m
CADDY_CPU_LIMIT=1.0
SCHEDULER_MEMORY_LIMIT=512m
SCHEDULER_CPU_LIMIT=0.5

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/app/**",
      "/config/**",
      "/pyproject.toml",
      "/Dockerfile",
      "/deploy/railway/scheduler.railway.json"
    ]
  },
  "deploy": {
    "startCommand": "tractusmind-scheduler",
    "restartPolicyType": "ALWAYS"
  }
}

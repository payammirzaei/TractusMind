{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/app/**",
      "/config/**",
      "/migrations/**",
      "/pyproject.toml",
      "/alembic.ini",
      "/Dockerfile",
      "/deploy/railway/api.railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "tractusmind-db bootstrap"
    ],
    "startCommand": "/bin/sh -c \"exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*' --timeout-graceful-shutdown 30\"",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}

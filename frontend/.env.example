TRACTUSMIND_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TractusMind Mission Control

# Optional enterprise browser login. Configure the IdP client as a public
# Authorization Code + PKCE client; do not provide a client secret.
TRACTUSMIND_OIDC_ISSUER_URL=
TRACTUSMIND_OIDC_CLIENT_ID=
TRACTUSMIND_OIDC_SCOPES=openid profile email
# Optional explicit callback. Recommended behind a production reverse proxy.
TRACTUSMIND_OIDC_REDIRECT_URI=

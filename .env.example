APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://tractusmind:tractusmind@postgres:5432/tractusmind
REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tractusmind_knowledge

# Optional for public repositories, recommended to avoid low GitHub API rate limits.
GITHUB_TOKEN=

# Any OpenAI-compatible chat-completions endpoint, for example a provider ending in /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
GENERATION_CONTEXT_MAX_CHARS=24000
VERIFICATION_MAX_CLAIMS=12

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_BATCH_SIZE=32
HYBRID_PREFETCH_K=40
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32

# Debug queries fuse exact phrase/symbol/path lookup with normal hybrid retrieval.
DEBUG_EXACT_K=30
DEBUG_RRF_K=60
DEBUG_EXACT_WEIGHT=1.5
DEBUG_HYBRID_WEIGHT=1.0

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tractusmind-raw
S3_REGION=auto

# Hybrid/debug candidates sent to the cross-encoder.
RETRIEVAL_TOP_K=20
# Final evidence count after reranking and generation context building.
RERANK_TOP_K=6
# Optional calibrated cross-encoder cutoff. Leave unset until benchmarked.
# MINIMUM_RELEVANCE_SCORE=

APP_ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

# HTTP boundary. Production uses the stricter values in .env.production.example.
TRUSTED_HOSTS=localhost,127.0.0.1,api,testserver
CORS_ORIGINS=
TRUST_FORWARDED_FOR=false
REQUEST_MAX_BODY_BYTES=65536
MAX_CONCURRENT_REQUESTS=64
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

DATABASE_URL=postgresql+asyncpg://tractusmind:tractusmind@postgres:5432/tractusmind
REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tractusmind_knowledge

# Optional for public repositories, recommended to avoid low GitHub API rate limits.
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_ATTEMPTS=4

# Optional event-driven ingestion. Configure GitHub push webhooks to POST to
# /v1/webhooks/github and use the same strong secret here. Deliveries are HMAC verified
# and deduplicated before a matching source is enqueued.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_DELIVERY_TTL_SECONDS=86400

# Any OpenAI-compatible chat-completions endpoint, for example a provider ending in /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
GENERATION_CONTEXT_MAX_CHARS=24000
VERIFICATION_MAX_CLAIMS=12
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARS=6000

# Optional enterprise OIDC access tokens. API-key bearer auth remains supported.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_ROLE_CLAIMS=roles,realm_access.roles,groups
OIDC_ADMIN_ROLES=
OIDC_OPERATOR_ROLES=
OIDC_DISPLAY_NAME_CLAIMS=name,preferred_username,email
OIDC_HTTP_TIMEOUT_SECONDS=10
OIDC_CACHE_TTL_SECONDS=3600

# Shared bounded external-provider retry/circuit policy.
PROVIDER_RETRY_BASE_SECONDS=0.5
PROVIDER_RETRY_MAX_SECONDS=8
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_BATCH_SIZE=32
HYBRID_PREFETCH_K=40
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32

DEBUG_EXACT_K=30
DEBUG_RRF_K=60
DEBUG_EXACT_WEIGHT=1.5
DEBUG_HYBRID_WEIGHT=1.0

# Third-party source repos cannot always install our webhook. The scheduler therefore
# remains as a self-healing fallback and checks enabled sources every five minutes.
SOURCE_SYNC_INTERVAL_SECONDS=300
SOURCE_SYNC_LOCK_SECONDS=43200

# Break-glass admin credential for /v1/ops/*. Prefer bearer admin/operator roles for normal use.
OPS_ADMIN_KEY=

# Prometheus metrics are open in development. Production can use the custom header or Bearer auth.
METRICS_ENABLED=true
METRICS_ADMIN_KEY=
WORKER_METRICS_PORT=9101
SCHEDULER_METRICS_PORT=9102
dramatiq_prom_host=0.0.0.0
dramatiq_prom_port=9191

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-before-production

OTEL_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=tractusmind-api
OTEL_SAMPLE_RATIO=1.0

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tractusmind-raw
S3_REGION=auto

RETRIEVAL_TOP_K=20
RERANK_TOP_K=6
# MINIMUM_RELEVANCE_SCORE=

# Instead of plaintext secret values, Settings also supports *_FILE for:
# DATABASE_URL, REDIS_URL, QDRANT_API_KEY, GITHUB_TOKEN, GITHUB_WEBHOOK_SECRET,
# LLM_API_KEY, OPS_ADMIN_KEY, and METRICS_ADMIN_KEY. Production Compose uses this path.

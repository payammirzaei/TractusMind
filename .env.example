APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://tractusmind:tractusmind@postgres:5432/tractusmind
REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tractusmind_knowledge

# Optional for public repositories, recommended to avoid low GitHub API rate limits.
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_ATTEMPTS=4

# Any OpenAI-compatible chat-completions endpoint, for example a provider ending in /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
GENERATION_CONTEXT_MAX_CHARS=24000
VERIFICATION_MAX_CLAIMS=12
# Authenticated owned conversations may contribute bounded context to follow-up questions.
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARS=6000

# Shared bounded external-provider retry/circuit policy.
PROVIDER_RETRY_BASE_SECONDS=0.5
PROVIDER_RETRY_MAX_SECONDS=8
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_BATCH_SIZE=32
HYBRID_PREFETCH_K=40
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32

# Debug queries fuse exact phrase/symbol/path lookup with normal hybrid retrieval.
DEBUG_EXACT_K=30
DEBUG_RRF_K=60
DEBUG_EXACT_WEIGHT=1.5
DEBUG_HYBRID_WEIGHT=1.0

# Background ingestion: enqueue all enabled sources every 6h by default.
SOURCE_SYNC_INTERVAL_SECONDS=21600
# Distributed per-source lock TTL; must exceed the expected longest sync.
SOURCE_SYNC_LOCK_SECONDS=43200

# Required to use /v1/ops/* endpoints. Send as X-TractusMind-Admin-Key.
OPS_ADMIN_KEY=

# Prometheus metrics are open in development. In non-development environments, configure
# METRICS_ADMIN_KEY (or OPS_ADMIN_KEY) and send it as X-TractusMind-Metrics-Key.
METRICS_ENABLED=true
METRICS_ADMIN_KEY=
# TractusMind domain metrics from worker and scheduler processes.
WORKER_METRICS_PORT=9101
SCHEDULER_METRICS_PORT=9102
# Dramatiq's native queue/runtime metrics are exported separately.
dramatiq_prom_host=0.0.0.0
dramatiq_prom_port=9191

# Local Grafana login. Replace the password before any externally reachable deployment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-before-production

# Optional OTLP/HTTP traces endpoint. Leave empty to disable tracing export.
# Example: http://otel-collector:4318/v1/traces
OTEL_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=tractusmind-api
OTEL_SAMPLE_RATIO=1.0

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tractusmind-raw
S3_REGION=auto

# Hybrid/debug candidates sent to the cross-encoder.
RETRIEVAL_TOP_K=20
# Final evidence count after reranking and generation context building.
RERANK_TOP_K=6
# Optional calibrated cross-encoder cutoff. Leave unset until benchmarked.
# MINIMUM_RELEVANCE_SCORE=

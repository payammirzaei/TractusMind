APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://tractusmind:tractusmind@postgres:5432/tractusmind
REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tractusmind_knowledge

# Optional for public repositories, recommended to avoid low GitHub API rate limits.
GITHUB_TOKEN=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_BATCH_SIZE=32
HYBRID_PREFETCH_K=40
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tractusmind-raw
S3_REGION=auto

# Hybrid candidates sent to the cross-encoder.
RETRIEVAL_TOP_K=20
# Final evidence count after reranking (used by downstream generation later).
RERANK_TOP_K=6
# Leave unset until calibrated on the fixed TractusMind benchmark.
# MINIMUM_RELEVANCE_SCORE=
